+// Preview adapter: sample the actual solved B-spline surface. This only writes
+// geometry; it does not change the integrator, control points or contacts.
+static void ExportPreviewSurface(BSIPC::Solver& solver)
+{
+    const unsigned int outputStride = std::getenv("PHYAI_EXPORT_STRIDE") ? std::atoi(std::getenv("PHYAI_EXPORT_STRIDE")) : 5;
+    if (!std::getenv("PHYAI_EXPORT_PREVIEW") || solver.CurStep() % outputStride != 0) return;
+    std::filesystem::create_directories("preview_meshes");
+    auto surface = solver.GetTarget(0);
+    const unsigned int subdivisions = 4;
+    const unsigned int nx = surface->UDomainMax() * subdivisions + 1;
+    const unsigned int ny = surface->VDomainMax() * subdivisions + 1;
+    std::ofstream file("preview_meshes/frame_" + std::to_string(solver.CurStep()/outputStride) + ".obj");
+    file.precision(15);
+    for (unsigned int y=0; y<ny; ++y) for (unsigned int x=0; x<nx; ++x) {
+        auto p = surface->EvalAt(double(x)/subdivisions, double(y)/subdivisions);
+        file << "v " << p.x() << " " << p.y() << " " << p.z() << "\n";
+    }
+    for (unsigned int y=0; y+1<ny; ++y) for (unsigned int x=0; x+1<nx; ++x) {
+        unsigned int a=y*nx+x+1, b=a+1, c=a+nx, d=c+1;
+        file << "f " << a << " " << b << " " << d << "\n";
+        file << "f " << a << " " << d << " " << c << "\n";
+    }
+}
+
 //#define BSIPC_YAML2OBJ
 //#undef BSIPC_YAML2OBJ
 
